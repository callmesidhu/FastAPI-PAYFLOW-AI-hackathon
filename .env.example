# ==============================================================================
# PAYFLOW AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or backend/.env and populate with your own credentials.
# NEVER commit real credentials or .env files to version control.
# ==============================================================================

# Application Core Settings
APP_ENV=development
APP_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=payflow_ai

# PayPal REST API (Sandbox Default)
# Official Sandbox endpoint: https://api-m.sandbox.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here

# AI Provider Configuration (Default: Gemini)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash

# Optional Integrations
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# ZAPIER_WEBHOOK_URL=
