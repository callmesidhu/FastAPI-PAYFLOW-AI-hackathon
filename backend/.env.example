# ==============================================================================
# PAYFLOW AI - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or backend/.env and populate with your credentials.
# NEVER commit real credentials or .env files to version control.
# ==============================================================================

# Core Application Settings
APP_ENV=development
APP_NAME="PAYFLOW AI"
APP_SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=payflow_ai

# PayPal REST API (Sandbox Default)
# Official Sandbox endpoint: https://api-m.sandbox.paypal.com
# Obtain Sandbox credentials from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=placeholder_sandbox_client_id
PAYPAL_CLIENT_SECRET=placeholder_sandbox_client_secret
PAYPAL_WEBHOOK_ID=placeholder_sandbox_webhook_id

# AI Provider Configuration
AI_PROVIDER=gemini
AI_API_KEY=placeholder_gemini_api_key
AI_MODEL=gemini-2.5-flash

# Optional Integrations
EMAIL_PROVIDER=
ZAPIER_WEBHOOK_URL=
